{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "noPropertyAccessFromIndexSignature": false,
    "pretty": true,
    "paths": {
      "@cordn/core": ["./packages/core/src/index.ts"],
      "@cordn/coordinator": ["./packages/coordinator/src/index.ts"],
      "@cordn/server": ["./packages/server/src/index.ts"],
      "@cordn/test-utils": ["./packages/test-utils/src/index.ts"],
      "@cordn/sdk": ["./packages/sdk/src/index.ts"],
      "@cordn/sdk/engine": ["./packages/sdk/src/engine/index.ts"],
      "@cordn/sdk/extra": ["./packages/sdk/src/extra/index.ts"],
      "@cordn/sdk/testing": ["./packages/sdk/src/testing/index.ts"],
      "@cordn/sdk/mls": ["./packages/sdk/src/mls.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
