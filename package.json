{
  "name": "cordn",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "pnpm run server:start",
    "build": "esbuild ./packages/server/src/main.ts --bundle --outdir=./dist --target=node22 --format=esm --packages=external",
    "release": "pnpm run build && changeset publish",
    "version": "changeset version",
    "typecheck": "tsc --noEmit",
    "client:cli": "node ./packages/cli/src/main.ts",
    "server:start": "node ./packages/server/src/main.ts",
    "test": "vitest run packages",
    "bench:sqlite-subscriptions": "node ./packages/coordinator/src/storage/sqliteSubscriptionBenchmark.ts",
    "format": "prettier --write \"./packages\" ./tsconfig.json ./package.json ./README.md",
    "login": "npm login --userconfig ./.npmrc"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.2",
    "esbuild": "^0.27.7",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
