{
  "name": "cordn",
  "version": "0.2.2",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm run server:start",
    "build": "esbuild ./src/server/main.ts --bundle --outdir=./dist --target=node22 --format=esm --packages=external",
    "typecheck": "tsc --noEmit",
    "client:cli": "node ./src/cli/main.ts",
    "server:start": "node ./src/server/main.ts",
    "test": "vitest run ./src",
    "bench:sqlite-subscriptions": "node ./src/coordinator/storage/sqliteSubscriptionBenchmark.ts",
    "format": "prettier --write ./src ./tsconfig.json ./package.json ./README.md"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.2",
    "esbuild": "^0.27.7",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@contextvm/sdk": "^0.12.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@noble/ciphers": "^2.2.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.3",
    "nostr-tools": "^2.23.3",
    "pino": "^10.3.1",
    "ts-mls": "2.0.0-rc.12",
    "zod": "^4.4.3"
  }
}
